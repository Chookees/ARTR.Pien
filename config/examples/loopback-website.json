{
  "$schema": "../schemas/pien.schema.json",
  "schemaVersion": 1,
  "profile": "quick",
  "targets": [
    {
      "id": "loopback-site",
      "kind": "website",
      "url": "http://127.0.0.1:5088/",
      "authorization": {
        "confirmed": true,
        "notes": "Validate-ready loopback sample. Safe for pien validate / local scan against a loopback server you control."
      }
    }
  ],
  "network": {
    "allowPrivateNetworks": true,
    "allowedHosts": ["127.0.0.1", "localhost", "::1"],
    "maxRedirects": 5
  },
  "crawl": {
    "maxPages": 10,
    "maxDepth": 1,
    "respectRobotsTxt": true,
    "useSitemap": false,
    "sameOriginOnly": true
  },
  "policies": {
    "name": "balanced",
    "failOn": "high"
  },
  "output": {
    "directory": "./artifacts/pien",
    "formats": ["console", "json"]
  }
}
